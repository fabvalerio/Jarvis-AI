# J.A.R.V.I.S. Mark 13 M-13 OMNI - Variáveis de Ambiente
# ⚠️ IMPORTANTE: NUNCA COMMITAR O ARQUIVO .env REAL!
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM SUAS CHAVES

# 🔑 API do Google Gemini AI
# Obtenha sua chave em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_GEMINI_AQUI

# 📁 Diretório de trabalho (opcional)
# Se não especificado, usará a área de trabalho do usuário
WORKSPACE_PATH=

# ⚙️ Habilitar ações do sistema (true/false)
ENABLE_SYSTEM_ACTIONS=true

# 🌐 Configurações de rede (opcional)
# REQUEST_TIMEOUT=30
# MAX_RETRIES=3

# 📊 Configurações de logging (opcional)
# LOG_LEVEL=INFO
# LOG_FILE=jarvis.log

# =====================================================
# 🤖 MULTI-AI ROUTER — Provedores (habilite os que tiver)
# =====================================================

# Claude (Anthropic) — https://console.anthropic.com
ANTHROPIC_API_KEY=COLOQUE_SUA_CHAVE_ANTHROPIC_AQUI
CLAUDE_MODEL=claude-sonnet-4-6

# ChatGPT (OpenAI) — https://platform.openai.com
OPENAI_API_KEY=COLOQUE_SUA_CHAVE_OPENAI_AQUI
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (Nvidia + modelos gratuitos) — https://openrouter.ai
OPENROUTER_API_KEY=COLOQUE_SUA_CHAVE_OPENROUTER_AQUI
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free

# Painel Web (porta padrão: 5000)
PANEL_PORT=5000
PANEL_SECRET=mude-esta-chave-secreta

# =====================================================
# 📱 WHATSAPP BRIDGE (Evolution API - open source)
# Documentação: https://doc.evolution-api.com
# Docker: docker run -d -p 8080:8080 atendai/evolution-api:latest
# =====================================================
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=COLOQUE_SUA_EVOLUTION_API_KEY_AQUI
WHATSAPP_INSTANCE=jarvis

# =====================================================
# 🎨 GERAÇÃO DE IMAGENS AI
# =====================================================

# Stability AI (plano gratuito disponível)
# Cadastro: https://platform.stability.ai
STABILITY_API_KEY=COLOQUE_SUA_STABILITY_KEY_AQUI

# Pollinations AI: 100% gratuito, sem API key necessária
# Usado automaticamente quando Stability não está configurado

# Diretório para salvar imagens geradas
IMAGE_OUTPUT_DIR=jarvis_images

# =====================================================
# 📅 CRONOGRAMAS
# =====================================================

# Diretório para salvar cronogramas gerados
SCHEDULES_DIR=jarvis_schedules
